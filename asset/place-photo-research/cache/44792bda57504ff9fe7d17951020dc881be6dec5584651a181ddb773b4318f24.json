eum of the People's Army of the Socialist Republic of Vietnam.  It is located at street address 247 Hoang Van Thu near the international airport for Ho Chi Minh City.","source":"commons-desc-page"},"Artist":{"value":"Tucker Smallwood","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 3.0","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/3.0","source":"commons-desc-page"},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}],"coordinates":[{"lat":10.80003333,"lon":106.66614722,"primary":true,"globe":"earth"}]},{"pageid":35129161,"ns":6,"title":"File:Ho coc beach .jpg","imagerepository":"local","imageinfo":[{"size":967401,"width":2816,"height":1872,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2c/Ho_coc_beach_.jpg/1280px-Ho_coc_beach_.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1280,"thumbheight":851,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/2/2c/Ho_coc_beach_.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2c/Ho_coc_beach_.jpg/1280px-Ho_coc_beach_.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1280,"height":851,"srcset":"https://upload.wikimedia.org/wikipedia/commons/2/2c/Ho_coc_beach_.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/2/2c/Ho_coc_beach_.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Ho_coc_beach_.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=35129161","extmetadata":{"ObjectName":{"value":"Ho coc beach ","source":"mediawiki-metad