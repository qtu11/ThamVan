edia.org/wikipedia/commons/thumb/c/c3/Enumeratio_plantarum_%3Fin_Japonia_sponte_crescentium_hucusque_rite_cognitarum%2C_adjectis_descriptionibus_specierum_pro_regione_novarum_%28IA_mobot31753000095981%29.pdf/page1-1280px-thumbnail.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1280,"height":2198,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c3/Enumeratio_plantarum_%3Fin_Japonia_sponte_crescentium_hucusque_rite_cognitarum%2C_adjectis_descriptionibus_specierum_pro_regione_novarum_%28IA_mobot31753000095981%29.pdf/page1-3840px-thumbnail.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/c/c3/Enumeratio_plantarum_%3Fin_Japonia_sponte_crescentium_hucusque_rite_cognitarum%2C_adjectis_descriptionibus_specierum_pro_regione_novarum_%28IA_mobot31753000095981%29.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Enumeratio_plantarum_%3Fin_Japonia_sponte_crescentium_hucusque_rite_cognitarum,_adjectis_descriptionibus_specierum_pro_regione_novarum_(IA_mobot31753000095981).pdf","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=92011061","extmetadata":{"ObjectName":{"value":"<div class=\"fn\">\nEnumeratio plantarum ?in Japonia sponte crescentium hucusque rite cognitarum, adjectis descriptionibus specierum pro regione novarum, quibus accedit determinatio herbarum in libris japonicis So mokou zoussetz xylographice delineatarum /auctoribus A. Franchet et Lud. Savatier.</div>","source":"commons-desc-page"},"Artist":{"value":"<div class=\"fn value\">\n<dl><dd>Franchet, Adrien,</dd>\n<dd>Savatier, Ludovic,</dd></dl></div>","source":"commons-desc-page"},"ImageDescription":{"value":"<div class=\"description\">\nSubjects:</div>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""}},"mime":"application/pdf"}]},{"pageid":92404841,"ns":6,"title":"File:ESUPPO- next generation (IA esupponextgenera1094556731).pdf","index":4,"imagerepository":"local","imageinfo":[{"size":2933088,"width":1275,"height":1650,"pagecount":82,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/33/ESUPPO-_next_generation_%28IA_esupponextgenera1094556731%29.pdf/page1-960px-ESUPPO-_next_generation_%28IA_esupponextgenera1094556731%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1280,"thumbheight":1656,"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/33/ESUPPO-_next_generation_%28IA_esupponextgenera1094556731%29.pdf/page1-960px-ESUPPO-_next_generation_%28IA_esupponextgenera1094556731%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1280,"height":1656},"url":"https://upload.wikimedia.org/wikipedia/commons/3/33/ESUPPO-_next_generation_%28IA_esupponextgenera1094556731%29.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:ESUPPO-_next_generation_(IA_esupponextgenera1094556731).pdf","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=92404841","extmetadata":{"ObjectName":{"value":"<div class=\"fn\">\neSUPPO: next generation</div>","source":"commons-desc-page"},"Artist":{"value":"<div class=\"fn value\">\n<dl><dd>House, Thomas D.</dd>\n<dd>Longworth, Joshua D.</dd>\n<dd>Pennycooke, Carlisle C.</dd></dl></div>","source":"commons-desc-page"},"ImageDescription":{"value":"<div class=\"description\">\n<p>This study evaluates eSUPPO and suggests an updated version for the U.S. Navy Supply Corps community. To accomplish this task effectively, a comprehensive examination of the current capabilities, via focus groups and surveys, assesses how well the mobile app meets the needs of the Supply Corps community. The analysis begins by understanding the unmet needs experienced by Supply Corps officers while using eSUPPO. Next, the authors of this study identify the improvements that should be made to the app. After a complete analysis of eSUPPO's current As-Is processes, the study takes the information gathered from both the survey and focus groups, develops and recommends a To-Be process, and presents the result to NAVSUP Business Systems Center (BSC). The authors of this study estimate that the Supply Corps community should benefit greatly from an upgraded app, as easy access to the most important information would be readily available when needed. The upgraded version of the app would include a mentoring section to provide junior Supply Corps officers with the opportunity to receive advice from a senior officer in any fleet concentration area. The app would also bring the fleet closer together by including an announcement section for all the fleet concentration areas, which would list current and future events taking place in each location. An operational icon will also be included in the upgraded version with the contact information for all the Fleet Logistics Centers.\n</p>\n<br>Subjects: application; eSUPPO; mobile; NAVSUP; Supply Corps</div>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""}},"mime":"application/pdf"}]},{"pageid":168592307,"ns":6,"title":"File:OJ C 213 of 2019 - EN English.pdf","index":3,"imagerepository":"local","imageinfo":[{"size":3891028,"width":1239,"height":1752,"pagecount":96,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a1/OJ_C_213_of_2019_-_EN_English.pdf/page1-960px-OJ_C_213_of_2019_-_EN_English.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_conte