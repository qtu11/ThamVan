# Site origin, no trailing slash. Use HTTPS in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Copy Project URL and publishable key from Supabase Project Settings > API.
# These are public identifiers; RLS protects data. Never put a secret/service key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable after running migration 003 and configuring Google in Supabase Auth Providers.
# Google Client ID/Secret belong in the Supabase dashboard, never in NEXT_PUBLIC_*.
AUTH_GOOGLE_ENABLED=false
# Server only. Used only for delete-account and recognition abuse limits.
SUPABASE_SERVICE_ROLE_KEY=
# Optional vision provider: OpenAI-compatible Chat Completions, HTTPS endpoint.
VISION_API_KEY=
VISION_API_URL=https://api.openai.com/v1/chat/completions
VISION_MODEL=
# Optional Cloudflare Turnstile. Set BOTH in production to protect signup/login/reset.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Commerce is disabled until migrations, content rights, support and live payment checks are complete.
COMMERCE_ENABLED=false
# Server only, from a verified payOS merchant channel. Never use NEXT_PUBLIC_* for these.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Real order/refund support address. Required before enabling checkout.
COMMERCE_SUPPORT_EMAIL=
