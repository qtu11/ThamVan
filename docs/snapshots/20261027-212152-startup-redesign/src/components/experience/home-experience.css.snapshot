.home-experience {
  --city-paper: #f6f0e3;
  background: var(--city-paper);
}
.home-experience .eyebrow {
  color: var(--terra-dark);
}
.city-experience {
  display: grid;
  grid-template-columns: minmax(0, 0.4fr) minmax(0, 0.6fr);
  max-width: 1800px;
  margin-inline: auto;
  position: relative;
}
.city-visual {
  --scene-ink: #0b4538;
  --scene-muted: #566354;
  --scene-panel: #f6f0e3;
  --scene-line: #bfc7b6;
  isolation: isolate;
  grid-column: 2;
  grid-row: 1;
  position: sticky;
  top: 89px;
  height: calc(100svh - 89px);
  min-height: 540px;
  overflow: hidden;
  background: var(--scene-panel);
  color: var(--scene-ink);
  transition: background-color 0.8s ease, color 0.8s ease;
}
.city-visual[data-city-time='sunset'] {
  --scene-ink: #fff1df;
  --scene-muted: #e2a694;
  --scene-panel: #271420;
  --scene-line: #74374b;
}
.city-visual[data-city-time='sunset'] .city-edition > span {
  color: #ff9d54;
}
.city-visual[data-city-time='dusk'] {
  --scene-ink: #e6e9df;
  --scene-muted: #bac7d3;
  --scene-panel: #071428;
  --scene-line: #49576b;
}
.city-visual[data-city-time='dusk'] .city-edition > span {
  color: #e8ba7a;
}
.city-time-switch {
  position: absolute;
  z-index: 2;
  top: 76px;
  right: 32px;
  display: flex;
  padding: 3px;
  gap: 2px;
  border: 1px solid var(--scene-line);
  border-radius: 30px;
  background: var(--scene-panel);
}
.city-time-switch button {
  min-height: 29px;
  padding: 5px 9px;
  display: flex;
  align-items: center;
  gap: 5px;
  border: 0;
  border-radius: 24px;
  font-size: 8px;
  color: var(--scene-muted);
  background: transparent;
}
.city-time-switch button[aria-pressed='true'] {
  color: var(--scene-panel);
  background: var(--scene-ink);
}
.city-visual button:focus-visible,
.city-stops a:focus-visible {
  outline: 2px solid var(--scene-ink);
  outline-offset: 3px;
}
.city-canvas-wrap,
.city-canvas,
.city-poster {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.city-poster {
  object-fit: contain;
}
.city-canvas-wrap {
  z-index: 0;
}
.city-canvas {
  transition: opacity 0.6s ease;
}
.city-canvas canvas {
  width: 100%;
  height: 100%;
  display: block;
}
.city-callout {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  padding: 5px 8px;
  border: 1px solid var(--scene-line);
  border-radius: 2px;
  background: var(--scene-panel);
  color: var(--scene-ink);
  font-size: 8px;
  font-weight: 500;
  letter-spacing: 0.12em;
  white-space: nowrap;
  opacity: 0;
  transition: opacity 0.25s;
  pointer-events: none;
}
.city-callout:after {
  content: '';
  position: absolute;
  left: 50%;
  top: 100%;
  height: 12px;
  width: 1px;
  background: var(--gold);
}
.city-visual-top,
.city-visual-bottom {
  z-index: 2;
  position: absolute;
  left: 28px;
  right: 32px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  pointer-events: none;
}
.city-visual-top {
  top: 28px;
}
.city-edition {
  font-size: 8px;
  font-weight: 500;
  letter-spacing: 0.16em;
}
.city-edition > span {
  padding-inline: 8px;
  color: var(--terra);
}
.motion-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  background: var(--scene-panel);
  color: var(--scene-ink);
  border: 1px solid var(--scene-line);
  border-radius: 30px;
  padding: 8px 12px;
  font-size: 9px;
  min-height: 36px;
  pointer-events: auto;
}
.motion-toggle:disabled {
  opacity: 1;
  color: var(--scene-muted);
}
.motion-toggle:hover:not(:disabled) {
  border-color: var(--scene-ink);
}
.city-model-note {
  z-index: 2;
  position: absolute;
  left: 28px;
  top: 75px;
  font-size: 9px;
  color: var(--scene-muted);
}
.city-visual-bottom {
  background: var(--scene-panel);
  bottom: 28px;
  padding-top: 20px;
  border-top: 1px solid var(--scene-line);
  transition: background-color 0.8s ease, border-color 0.8s ease;
}
.city-frame-number {
  font-family: var(--serif);
  font-size: 32px;
  letter-spacing: -0.05em;
  line-height: 1;
  white-space: nowrap;
}
.city-frame-number > span {
  font-family: var(--sans);
  font-size: 9px;
  letter-spacing: 0;
}
.city-stops {
  display: flex;
  gap: 20px;
  align-items: center;
  pointer-events: auto;
}
.city-stops a {
  display: inline-flex;
  gap: 7px;
  align-items: center;
  font-size: 10px;
  min-height: 32px;
  color: var(--scene-muted);
}
.city-stops a[aria-current] {
  color: var(--scene-ink);
  font-weight: 600;
}
.city-stop-dot {
  display: block;
  height: 5px;
  width: 5px;
  border-radius: 50%;
  border: 1px solid currentColor;
  flex-shrink: 0;
}
.city-stops a[aria-current] .city-stop-dot {
  background: var(--terra);
  border-color: var(--terra);
  box-shadow: 0 0 0 3px #b94f2d1a;
}
.city-render-mode {
  position: absolute;
  right: 32px;
  bottom: 102px;
  font-size: 8px;
  letter-spacing: 0.04em;
  color: var(--scene-muted);
  background: var(--scene-panel);
  padding: 4px 8px;
  border-radius: 4px;
  pointer-events: none;
}
.city-chapters {
  grid-column: 1;
  grid-row: 1;
  position: relative;
  padding-left: max(36px, calc((100vw - 1240px) / 2));
  padding-right: 12px;
}
.city-step {
  min-height: calc(100svh - 89px);
  padding-block: 68px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  scroll-margin-top: 0;
}
.city-step .eyebrow {
  font-size: 9px;
  letter-spacing: 0.13em;
  margin-bottom: 28px;
}
.city-step h1 {
  font-size: clamp(40px, 4.45vw, 72px);
  line-height: 1.2;
  margin-bottom: 24px;
  letter-spacing: -0.06em;
}
.city-step h1 em {
  font-weight: 400;
  color: var(--terra);
}
.city-step h2 {
  font-size: clamp(35px, 3.7vw, 54px);
  max-width: 400px;
  margin-bottom: 24px;
}
.city-description {
  font-size: 12px;
  line-height: 2;
  max-width: 350px;
  margin-bottom: 28px;
}
.city-enter.button {
  border-radius: 2px;
  min-height: 49px;
  font-size: 11px;
  gap: 26px;
  margin-top: 2px;
}
.scroll-invitation {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  margin-top: 54px;
  font-size: 9px;
  color: var(--muted);
}
.scroll-circle {
  width: 33px;
  height: 44px;
  border: 1px solid #bdc6b6;
  border-radius: 30px;
  display: grid;
  place-items: center;
}
[data-motion='on'] .scroll-circle svg {
  animation: city-scroll-hint 2.4s ease-in-out infinite;
}
@keyframes city-scroll-hint {
  0%,
  100% {
    transform: translateY(-3px);
  }
  50% {
    transform: translateY(3px);
  }
}
.city-detail-tag,
.skyline-names {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 8px;
  letter-spacing: 0.14em;
  margin-bottom: 32px;
}
.city-detail-tag > span {
  width: 24px;
  height: 1px;
  background: var(--gold);
}
.skyline-names > span {
  padding: 8px 12px;
  border: 1px solid #c8cebb;
}
.skyline-names {
  flex-wrap: wrap;
  gap: 8px;
}
.city-accuracy-note {
  font-size: 9px;
  max-width: 320px;
  margin-top: 28px;
  margin-bottom: 0;
}
.atlas-search {
  display: grid;
  grid-template-columns: 1fr 1.3fr auto;
  align-items: center;
  gap: 36px;
  padding-block: 28px;
  border-block: 1px solid #d8d9c7;
}
.atlas-search > span,
.atlas-search > a {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 11px;
}
.atlas-search > span {
  font-family: var(--serif);
  font-size: 18px;
}
.atlas-search .search-box {
  border-radius: 2px;
}
.heritage-intro {
  padding-block: 100px 56px;
}
.scroll-words {
  max-width: 1000px;
  font-family: var(--serif);
  font-size: clamp(30px, 3.6vw, 52px);
  line-height: 1.55;
  letter-spacing: -0.035em;
  color: var(--green);
  margin-bottom: 48px;
}
[data-motion='on'] .scroll-words > span {
  color: #748071;
  transition: color 0.35s ease;
}
[data-motion='on'] .scroll-words > span[data-read='true'] {
  color: var(--green);
}
.intro-footnote {
  border-top: 1px solid #d8d9c7;
  padding-top: 24px;
  display: flex;
  justify-content: space-between;
  gap: 24px;
  font-size: 9px;
  letter-spacing: 0.06em;
}
.intro-footnote > a {
  display: inline-flex;
  align-items: center;
  gap: 12px;
}
@media (min-width: 1800px) {
  .city-chapters {
    padding-left: 100px;
  }
}
@media (max-width: 1150px) {
  .city-experience {
    grid-template-columns: minmax(0, 0.43fr) minmax(0, 0.57fr);
  }
  .city-stops {
    gap: 10px;
  }
  .city-visual-bottom > svg {
    display: none;
  }
  .city-visual-top {
    align-items: flex-start;
  }
  .city-edition {
    max-width: 160px;
  }
  .atlas-search {
    gap: 20px;
  }
  .atlas-search > span {
    font-size: 15px;
  }
}
@media (max-width: 900px) {
  .city-experience {
    display: block;
  }
  .city-visual {
    height: 44svh;
    min-height: 285px;
    max-height: 460px;
    top: 73px;
    z-index: 2;
    border-bottom: 1px solid #d8d9c7;
  }
  .city-chapters {
    padding-inline: 32px;
    z-index: 1;
  }
  .city-step {
    min-height: 56svh;
    padding-block: 36px 44px;
    scroll-margin-top: calc(clamp(285px, 44svh, 460px) - 27px);
  }
  .city-opening {
    min-height: 58svh;
  }
  .city-step h1 {
    font-size: clamp(36px, 6.5vw, 54px);
  }
  .city-step h2 {
    font-size: clamp(30px, 5vw, 42px);
    max-width: 500px;
  }
  .city-description {
    max-width: 540px;
  }
  .city-step .eyebrow {
    margin-bottom: 16px;
  }
  .city-visual-top {
    top: 16px;
    left: 24px;
    right: 24px;
    align-items: center;
  }
  .city-edition {
    max-width: none;
  }
  .city-model-note {
    left: 24px;
    top: 58px;
    font-size: 8px;
  }
  .city-poster {
    transform: translateY(16px) scale(0.88);
  }
  .city-time-switch {
    top: 59px;
    right: 24px;
  }
  .city-time-switch button {
    min-height: 26px;
    font-size: 7px;
    padding: 4px 7px;
  }
  .city-visual-bottom {
    bottom: 14px;
    left: 24px;
    right: 24px;
    padding-top: 10px;
  }
  .city-frame-number {
    font-size: 23px;
  }
  .city-stops {
    gap: 22px;
  }
  .city-render-mode {
    right: 24px;
    bottom: 64px;
    font-size: 7px;
  }
  .scroll-invitation {
    margin-top: 24px;
  }
  .atlas-search {
    grid-template-columns: 1fr auto;
    padding-block: 24px;
  }
  .atlas-search > span {
    grid-column: 1 / -1;
  }
  .atlas-search > a {
    font-size: 10px;
  }
  .heritage-intro {
    padding-block: 64px 40px;
  }
}
@media (max-width: 640px) {
  .city-visual {
    height: 39svh;
    min-height: 270px;
    top: 73px;
  }
  .city-visual-top {
    left: 20px;
    right: 20px;
    gap: 8px;
  }
  .city-edition {
    font-size: 7px;
    letter-spacing: 0.05em;
    max-width: 165px;
  }
  .city-edition > span {
    padding-inline: 3px;
  }
  .city-time-switch {
    right: 20px;
    top: 58px;
  }
  .city-model-note {
    max-width: 120px;
    line-height: 1.7;
  }
  .motion-toggle {
    font-size: 8px;
    gap: 5px;
    padding: 7px 9px;
  }
  .city-model-note {
    left: 20px;
    top: 58px;
  }
  .city-visual-bottom {
    left: 20px;
    right: 20px;
  }
  .city-stops {
    gap: 14px;
  }
  .city-stops a {
    font-size: 8px;
    gap: 5px;
  }
  .city-frame-number {
    font-size: 22px;
  }
  .city-frame-number > span {
    font-size: 7px;
  }
  .city-chapters {
    padding-inline: 24px;
  }
  .city-step {
    min-height: 61svh;
    scroll-margin-top: calc(clamp(270px, 39svh, 460px) - 27px);
  }
  .city-opening {
    min-height: 61svh;
    justify-content: flex-start;
  }
  .city-step h1 {
    font-size: clamp(34px, 9vw, 45px);
    margin-bottom: 18px;
  }
  .city-step h2 {
    font-size: 32px;
    margin-bottom: 18px;
  }
  .city-step .eyebrow {
    font-size: 8px;
  }
  .city-description {
    font-size: 11px;
    line-height: 1.9;
    margin-bottom: 20px;
  }
  .city-accuracy-note {
    margin-top: 20px;
  }
  .scroll-invitation {
    margin-top: 20px;
    font-size: 8px;
  }
  .scroll-circle {
    height: 33px;
    width: 27px;
  }
  .city-enter.button {
    min-height: 44px;
    font-size: 10px;
  }
  .skyline-names {
    gap: 8px;
    font-size: 7px;
    margin-bottom: 20px;
  }
  .atlas-search {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .atlas-search > a {
    justify-content: flex-end;
  }
  .heritage-intro .eyebrow {
    font-size: 8px;
  }
  .scroll-words {
    font-size: 29px;
    margin-bottom: 32px;
  }
  .intro-footnote {
    font-size: 8px;
    gap: 12px;
  }
}
@media (max-height: 650px) and (min-width: 901px) {
  .city-visual {
    min-height: 450px;
  }
  .city-step {
    min-height: 560px;
    padding-block: 36px;
  }
  .city-step h1 {
    font-size: 48px;
  }
  .scroll-invitation {
    margin-top: 24px;
  }
}
@media (prefers-reduced-motion: reduce) {
  .city-canvas {
    transition: none;
  }
  .scroll-circle svg {
    animation: none;
  }
  .scroll-words > span {
    color: var(--green) !important;
  }
}
