'use client';

import { useEffect, useRef, useState } from 'react';
import Link from 'next/link';
import { ArrowDown, ArrowUpRight, Compass, Pause, Play } from 'lucide-react';
import { SearchBox } from '@/components/discovery';
import { t } from '@/lib/i18n';
import type { Locale } from '@/lib/types';
import { CityCanvas } from './city-canvas';
import { useStaticExperience } from './motion';
import type { CityTime } from './city-lighting';
import './home-experience.css';

export function HomeExperience({ locale }: { locale: Locale }) {
  const staticExperience = useStaticExperience();
  const [paused, setPaused] = useState(false);
  const [active, setActive] = useState(0);
  const [time, setTime] = useState<CityTime>('day');
  const motion = !staticExperience && !paused;
  const chapters = useRef<HTMLDivElement>(null);
  const visual = useRef<HTMLDivElement>(null);
  const reading = useRef<HTMLParagraphElement>(null);
  const progress = useRef(0);
  const sentence = t(locale, 'scrollManifesto');
  const words = locale === 'zh' ? Array.from(sentence) : sentence.split(/(\s+)/);

  useEffect(() => {
    visual.current?.dispatchEvent(new Event('city:lighting'));
  }, [time]);

  useEffect(() => {
    let frame = 0;
    const steps = Array.from(chapters.current?.querySelectorAll<HTMLElement>('.city-step') ?? []);
    const spans = reading.current?.querySelectorAll('span');
    const update = () => {
      frame = 0;
      if (steps.length > 1) {
        const first = steps[0].getBoundingClientRect();
        const last = steps[steps.length - 1].getBoundingClientRect();
        const view = visual.current?.getBoundingClientRect();
        const line = view ? (innerWidth <= 900 ? view.bottom : view.top) : 0;
        const next = Math.min(1, Math.max(0, (line - first.top) / (last.top - first.top)));
        if (visual.current) visual.current.dataset.scrollProgress = next.toFixed(3);
        if (next !== progress.current) {
          progress.current = next;
          // Notify after storing progress. A separate scroll listener can wake
          // an on-demand renderer before this measurement runs, losing the last frame.
          visual.current?.dispatchEvent(new Event('city:progress'));
        }
        setActive(Math.round(progress.current * (steps.length - 1)));
        const nextTime: CityTime = next < 0.3 ? 'day' : next < 0.7 ? 'sunset' : 'dusk';
        setTime((prev) => (prev !== nextTime ? nextTime : prev));
      }
      if (reading.current && spans && motion) {
        const box = reading.current.getBoundingClientRect();
        const reveal = Math.min(
          1,
          Math.max(0, (innerHeight * 0.86 - box.top) / (innerHeight * 0.52)),
        );
        spans.forEach((span, index) => {
          span.dataset.read = String(index / spans.length <= reveal);
        });
      }
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
    return () => {
      cancelAnimationFrame(frame);
      window.removeEventListener('scroll', schedule);
      window.removeEventListener('resize', schedule);
    };
  }, [motion, locale]);

  return (
    <div className="home-experience" data-motion={motion ? 'on' : 'off'}>
      <section className="city-experience" aria-label={t(locale, 'cityExperience')}>
        <div className="city-visual" ref={visual} data-city-time={time}>
          <CityCanvas
            motion={motion}
            progress={progress}
            locale={locale}
            time={time}
            view={active}
          />
          <div className="city-visual-top">
            <span className="city-edition">
              SÀI GÒN <span aria-hidden="true">/</span> TP. HỒ CHÍ MINH
            </span>
            <button
              className="motion-toggle"
              aria-pressed={motion}
              disabled={staticExperience}
              onClick={() => setPaused(!paused)}
            >
              {motion ? <Pause size={12} /> : <Play size={12} />}
              {t(locale, staticExperience ? 'motionReduced' : motion ? 'motionOn' : 'motionOff')}
            </button>
          </div>
          <span className="city-model-note">
            {t(locale, active === 0 ? 'cityBachDang' : active === 1 ? 'cityBaSon' : 'cityLandmark')}
          </span>
        </div>
        <div className="city-chapters" ref={chapters}>
          <div className="city-step city-opening" id="city-stop-0">
            <p className="eyebrow">
              <span />
              {t(locale, 'cityEyebrow')}
            </p>
            <h1>
              {t(locale, 'hero1')}
              <br />
              <em>{t(locale, 'hero2')}</em>
            </h1>
            <p className="city-description">{t(locale, 'cityIntro')}</p>
            <a href="#city-stop-1" className="button city-enter">
              {t(locale, 'enterCity')}
              <ArrowUpRight size={18} />
            </a>
            <a href="#city-stop-1" className="scroll-invitation">
              <span className="scroll-circle">
                <ArrowDown size={16} />
              </span>
              {t(locale, 'scrollInvitation')}
            </a>
          </div>
          <article className="city-step" id="city-stop-1">
            <p className="eyebrow">01 — {t(locale, 'cityRiver')}</p>
            <h2>{t(locale, 'cityRiverTitle')}</h2>
            <p className="city-description">{t(locale, 'cityRiverCopy')}</p>
            <span className="city-detail-tag">
              <span /> {t(locale, 'cityBaSon')}
            </span>
            <a href="#city-stop-2" className="text-link">
              {t(locale, 'cityNextView')}
              <ArrowDown size={16} />
            </a>
          </article>
          <article className="city-step" id="city-stop-2">
            <p className="eyebrow">02 — {t(locale, 'citySkyline')}</p>
            <h2>{t(locale, 'citySkylineTitle')}</h2>
            <p className="city-description">{t(locale, 'citySkylineCopy')}</p>
            <div className="skyline-names">
              <span>LANDMARK 81</span>
              <span>VINHOMES CENTRAL PARK</span>
            </div>
            <Link className="button city-enter" href={`/${locale}/explore`}>
              {t(locale, 'related')}
              <ArrowUpRight size={18} />
            </Link>
            <p className="city-accuracy-note">{t(locale, 'cityAccuracy')}</p>
          </article>
        </div>
      </section>
      <div className="atlas-search container">
        <span>
          <Compass size={21} />
          {t(locale, 'findNextStory')}
        </span>
        <SearchBox locale={locale} />
        <Link href={`/${locale}/map`}>
          {t(locale, 'mapAll')}
          <ArrowUpRight size={17} />
        </Link>
      </div>
      <section className="heritage-intro container" id="heritage-intro">
        <p className="eyebrow">
          <span />
          {t(locale, 'slogan')}
        </p>
        <p className="scroll-words" ref={reading}>
          {words.map((word, index) => (
            <span key={`${locale}-${index}`}>{word}</span>
          ))}
        </p>
        <div className="intro-footnote">
          <span>THÁM VĂN — {t(locale, 'lookCloser')}</span>
          <Link href={`/${locale}/explore`}>
            {t(locale, 'explore')}
            <ArrowUpRight size={15} />
          </Link>
        </div>
      </section>
    </div>
  );
}
