{
  "name": "tham-van",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "assets:sync": "node scripts/import-assets.mjs",
    "images:audit": "node --experimental-strip-types scripts/audit-place-images.mjs",
    "images:repair": "node --experimental-strip-types scripts/audit-place-images.mjs --apply",
    "images:discover": "node --experimental-strip-types scripts/discover-place-photos.mjs --all --apply --retry-errors",
    "images:wikipedia": "node --experimental-strip-types scripts/discover-place-photos.mjs --wikipedia-only --apply",
    "images:sources": "node --experimental-strip-types scripts/collect-source-photos.mjs --schools",
    "images:galleries": "node --experimental-strip-types scripts/collect-source-photos.mjs --galleries",
    "images:web": "node --experimental-strip-types scripts/stage-web-photos.mjs",
    "images:finalize": "node --experimental-strip-types scripts/finalize-photo-library.mjs",
    "city:poster": "node scripts/capture-city.mjs",
    "db:seed:generate": "node scripts/generate-seed.mjs",
    "env:check": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "5.0.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.12",
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
